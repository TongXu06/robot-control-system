
<?xml version="1.0"?>
<robot name="two_link_robot_arm">

  <!-- Base -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.10 0.05"/>
      </geometry>
      <material name="gray">
        <color rgba="0.45 0.50 0.55 1.0"/>
      </material>
    </visual>
  </link>

  <!-- Shoulder: rotate around Z -->
  <joint name="shoulder_joint" type="revolute">
    <parent link="base_link"/>
    <child link="upper_arm_link"/>

    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>

    <limit
      lower="0.0"
      upper="1.5707963"
      effort="10.0"
      velocity="1.0"/>
  </joint>

  <!-- Upper arm: length 0.12 m -->
  <link name="upper_arm_link">
    <visual>
      <origin xyz="0.06 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.028 0.028"/>
      </geometry>
      <material name="blue">
        <color rgba="0.12 0.45 0.95 1.0"/>
      </material>
    </visual>
  </link>

  <!-- Elbow: at end of upper arm -->
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>

    <origin xyz="0.12 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>

    <limit
      lower="-1.5707963"
      upper="1.5707963"
      effort="10.0"
      velocity="1.0"/>
  </joint>

  <!-- Forearm: length 0.10 m -->
  <link name="forearm_link">
    <visual>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.024 0.024"/>
      </geometry>
      <material name="green">
        <color rgba="0.10 0.75 0.50 1.0"/>
      </material>
    </visual>
  </link>

  <!-- Fixed connection to tool -->
  <joint name="tool_joint" type="fixed">
    <parent link="forearm_link"/>
    <child link="tool_link"/>
    <origin xyz="0.10 0 0" rpy="0 0 0"/>
  </joint>

  <!-- End effector marker -->
  <link name="tool_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.012"/>
      </geometry>
      <material name="red">
        <color rgba="0.95 0.22 0.18 1.0"/>
      </material>
    </visual>
  </link>

</robot>

